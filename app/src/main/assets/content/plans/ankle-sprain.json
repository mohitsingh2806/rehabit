{
  "id": "ankle-sprain",
  "name": "Ankle sprain recovery",
  "kind": "FOCUSED",
  "category": "REHAB",
  "goal": "Get a sprained ankle moving early, rebuild strength and balance, and cut the risk of spraining it again (balance training makes a big difference).",
  "whoFor": "People with a sprained ankle (rolled ankle) who can put weight on it.",
  "notFor": [
    "You couldn't take 4 steps straight after the injury, or still can't: get an X-ray check first"
  ],
  "estMinutes": 12,
  "trackedMetric": "Ankle pain when walking (0-10)",
  "painRules": "Mild discomfort is OK; sharp pain or a feeling of the ankle giving way is not. Walk normally as soon as you comfortably can.",
  "redFlags": [
    "You can't take 4 steps, now or straight after the injury",
    "Pain when pressing the back or tip of either ankle bone, or the bone on the outside of the midfoot",
    "Numbness, or a cold, pale foot",
    "The ankle looks deformed",
    "Swelling and pain getting worse after the first 2-3 days"
  ],
  "phases": [
    {
      "id": "move",
      "name": "Move and protect",
      "durationHint": "first 1-2 weeks",
      "entryCriteria": "Recent sprain, sore and swollen.",
      "exitCriteria": "Walking is close to normal.",
      "items": [
        {
          "exerciseId": "ankle-alphabet",
          "schedule": {
            "slots": [
              "MORNING",
              "NIGHT"
            ],
