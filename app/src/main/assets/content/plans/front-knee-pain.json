{
  "id": "front-knee-pain",
  "name": "Front-of-knee pain (patellofemoral)",
  "kind": "FOCUSED",
  "category": "REHAB",
  "goal": "Ease pain around the kneecap and build hip and thigh strength so stairs, squats and running feel good again. Load is managed, not avoided.",
  "whoFor": "People with patellofemoral pain: an ache around or behind the kneecap, worse on stairs, squatting, kneeling, long sitting or running.",
  "notFor": [
    "Pain just below the kneecap that's sharpest with jumping (see the patellar tendinopathy plan)",
    "Knee pain after a twist or fall that hasn't been checked"
  ],
  "estMinutes": 15,
  "trackedMetric": "Pain around the kneecap on stairs or squats (0-10)",
  "painRules": "Up to about 3 out of 10 during exercise is OK if it settles within an hour and isn't worse the next day. Choose squat depths and step heights that stay in that range and progress gradually.",
  "redFlags": [
    "The knee locks, gives way, or won't fully straighten",
    "Fast, large swelling after an injury",
    "A hot, red, swollen knee, or fever",
    "Calf pain with swelling and warmth (possible blood clot)",
    "Pain after a fall or twist that hasn't been checked"
  ],
  "avoid": [
    "couch-stretch"
  ],
  "phases": [
