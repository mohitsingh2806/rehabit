{
  "id": "it-band-syndrome",
  "name": "IT band syndrome (outer knee pain in runners)",
  "kind": "FOCUSED",
  "category": "REHAB",
  "goal": "Settle outer-knee pain and fix what usually drives it: weak side-hip muscles and too much running load too soon. (Stretching the IT band itself does little: it barely stretches.)",
  "whoFor": "Runners and hikers diagnosed with IT band syndrome: sharp pain on the outside of the knee that comes on at a predictable point in a run, often worse downhill.",
  "notFor": [
    "Knee pain after a twist or fall that hasn't been checked",
    "Pain inside the knee joint with swelling or locking"
  ],
  "estMinutes": 15,
  "trackedMetric": "Pain on the outside of the knee during or after running (0-10)",
  "painRules": "Strength work can cause mild muscle burn; the outer knee should stay at 3 out of 10 or less. While it's sore, run only as far as you can without pain, on flat ground, and shorten your stride a little (cadence up 5-10%).",
  "redFlags": [
    "The knee locks, gives way, or won't fully straighten",
    "Fast, large swelling after an injury",
    "A hot, red, swollen knee, or fever",
    "Calf pain with swelling and warmth (possible blood clot)",
    "Pain after a fall or twist that hasn't been checked"
  ],
